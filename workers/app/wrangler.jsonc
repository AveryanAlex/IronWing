{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ironwing-app",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "../../dist/web",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "app.ironwing.dev",
      "custom_domain": true
    }
  ]
}
