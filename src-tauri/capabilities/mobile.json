{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-default",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "blec:default",
    "bluetooth-classic:default",
    "geolocation:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://raw.githubusercontent.com/ArduPilot/ParameterRepository/main/*" },
        { "url": "https://api.github.com/repos/ArduPilot/ParameterRepository/git/trees/main" },
        { "url": "https://s3.amazonaws.com/elevation-tiles-prod/*" }
      ]
    }
  ]
}
